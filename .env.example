JWT_SECRET=replace-with-a-long-random-secret
AURA_GITHUB_CLIENT_ID=replace-with-your-github-oauth-app-client-id
AURA_GITHUB_CLIENT_SECRET=replace-with-a-new-rotated-client-secret
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-a-new-rotated-google-client-secret
AURA_PUBLIC_URL=https://your-public-domain.example
AURA_DESKTOP_DEFAULT_SERVER_URL=
AURA_DESKTOP_VERSION=0.1.0
# Set the GitHub owner/repository after publishing a signed desktop-v<version> release.
AURA_DESKTOP_GITHUB_REPOSITORY=
# Optional per-platform HTTPS links override the matching GitHub release asset URL.
AURA_WINDOWS_DOWNLOAD_URL=
AURA_MACOS_DOWNLOAD_URL=
AURA_LINUX_DOWNLOAD_URL=
# Optional paths to local installer files; named macOS and Linux build outputs are auto-detected.
AURA_WINDOWS_INSTALLER_PATH=
AURA_MACOS_INSTALLER_PATH=
AURA_LINUX_INSTALLER_PATH=

# Register this exact callback URL in your GitHub OAuth App:
# https://your-public-domain.example/api/v1/auth/github/callback
# Register this exact redirect URI in your Google OAuth client:
# https://your-public-domain.example/api/v1/auth/google/callback

# AI provider keys must be rotated before use if they were ever shared.
# Set one or both provider keys, then select the provider explicitly.
DEEPSEEK_API_KEY=replace-with-a-new-rotated-deepseek-key
GROQ_API_KEY=replace-with-a-new-rotated-groq-key
AURA_AI_PROVIDER=deepseek
# Optional model overrides:
# AURA_DEEPSEEK_MODEL=deepseek-chat
# AURA_GROQ_MODEL=llama-3.3-70b-versatile
